# Server-side ingestion only. Never prefix this with PUBLIC_.
OPENROUTER_API_KEY=
# Optional. These defaults use OpenRouter's current DeepSeek V4 Flash alias.
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=AI Knowledge Wiki
# Optional attribution header, for example https://github.com/OWNER/REPOSITORY.
OPENROUTER_HTTP_REFERER=
# Optional: raises GitHub API limits during local harvesting.
GITHUB_TOKEN=
