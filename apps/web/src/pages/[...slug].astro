---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { entryPath, isRootIndex, titleFor } from "../lib/wiki";

interface Props {
  entry: CollectionEntry<"wiki">;
}

export async function getStaticPaths() {
  return (await getCollection("wiki"))
    .filter((entry) => !isRootIndex(entry))
    .map((entry) => ({
      params: { slug: entryPath(entry.id).replace(/^\/|\/$/g, "") },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const rendered = await render(entry);
const title = titleFor(entry);
const layoutProps = {
  title,
  ...(entry.data.description ? { description: entry.data.description } : {}),
};
---

<BaseLayout {...layoutProps}>
  <article class="prose">
    {entry.data.type && <p class="eyebrow">{entry.data.type}</p>}
    <rendered.Content />
    {
      entry.data.tags.length > 0 && (
        <div class="chips">
          {entry.data.tags.map((tag) => (
            <span class="chip">{tag}</span>
          ))}
        </div>
      )
    }
    {
      (entry.data.resource || entry.data.timestamp) && (
        <footer class="concept-meta">
          {entry.data.resource && (
            <a
              href={entry.data.resource}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open resource ↗
            </a>
          )}
          {entry.data.timestamp && (
            <time datetime={entry.data.timestamp.toISOString()}>
              Updated {entry.data.timestamp.toLocaleDateString("en-CA")}
            </time>
          )}
        </footer>
      )
    }
  </article>
</BaseLayout>
