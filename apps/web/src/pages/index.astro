---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { highlights, toItems } from "../lib/changelog";
import { isRootIndex, withBase } from "../lib/wiki";

const base = import.meta.env.BASE_URL;
const root = (await getCollection("wiki")).find(isRootIndex);
if (!root) throw new Error("openwiki/index.md is required");
const rendered = await render(root);

const recent = highlights(
  toItems((await getCollection("changelog")).map((fragment) => fragment.data)),
  3,
);
const dayFormat = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeZone: "UTC",
});
---

<BaseLayout title="Home">
  {
    recent.length > 0 && (
      <section class="recent">
        <p class="eyebrow">What&rsquo;s new</p>
        <div class="grid">
          {recent.map((item) => (
            <a class="card" href={withBase(item.href ?? "/", base)}>
              <small>
                {item.kind === "new" ? "New" : "Updated"} &middot;{" "}
                {dayFormat.format(item.runAt)}
              </small>
              <strong>{item.title}</strong>
              {item.summary && (
                <small class="card-summary">{item.summary}</small>
              )}
            </a>
          ))}
        </div>
        <p class="meta">
          <a href={withBase("/whats-new/", base)}>
            See everything that changed &rarr;
          </a>
        </p>
      </section>
    )
  }
  <article class="prose"><rendered.Content /></article>
</BaseLayout>

<style>
  .recent {
    margin-bottom: 3.5rem;
  }
  .recent .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .card-summary {
    /* Descriptions are a full sentence or two; the card shows the opening. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
</style>
