---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";
import { highlights, toItems } from "../lib/changelog";
import { SITE_DESCRIPTION, SITE_TITLE } from "../lib/constants";
import { withBase } from "../okf";

/**
 * The landing page, and deliberately not the OKF corpus root.
 *
 * `openwiki/index.md` loads with an empty id, so Starlight would otherwise
 * serve its generated "Files / Directories" listing at `/`. A static page here
 * outranks Starlight's injected catch-all route and takes `/` over; the sidebar
 * still exposes every directory the listing pointed at. What a reader wants
 * first is what changed, so that is what the page opens on.
 */

const base = import.meta.env.BASE_URL;
const recent = highlights(
  toItems(
    (await getCollection("changelog")).map((fragment) => ({
      ...fragment.data,
      runId: fragment.id,
    })),
  ),
  3,
);

const dayFormat = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeZone: "UTC",
});
const kindLabels = { new: "New", updated: "Updated", removed: "Removed" };
---

<StarlightPage
  frontmatter={{
    title: SITE_TITLE,
    description: SITE_DESCRIPTION,
    template: "splash",
    tableOfContents: false,
    hero: {
      tagline: SITE_DESCRIPTION,
      actions: [
        {
          text: "What's new",
          link: withBase("/whats-new/", base),
          variant: "primary",
          icon: "right-arrow",
        },
        {
          text: "Browse the wiki",
          link: withBase("/quickstart/", base),
          variant: "secondary",
        },
      ],
    },
  }}
>
  {
    recent.length > 0 && (
      <section class="recent">
        <p class="eyebrow">What&rsquo;s new</p>
        <div class="grid">
          {recent.map((item) => (
            <a class="card" href={withBase(item.href ?? "/", base)}>
              <small class="card-meta">
                {kindLabels[item.kind]} &middot; {dayFormat.format(item.runAt)}
              </small>
              <strong>{item.title}</strong>
              {item.summary && (
                <small class="card-summary">{item.summary}</small>
              )}
            </a>
          ))}
        </div>
        <p class="more">
          <a href={withBase("/whats-new/", base)}>
            See everything that changed &rarr;
          </a>
        </p>
      </section>
    )
  }
</StarlightPage>

<style>
  .recent {
    margin: 0 auto;
    max-width: 60rem;
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--sl-color-accent);
  }
  .card strong {
    font-size: var(--sl-text-lg);
    line-height: 1.3;
  }
  .card-meta {
    color: var(--sl-color-gray-3);
  }
  .card-summary {
    color: var(--sl-color-gray-2);
    /* Descriptions are a full sentence or two; the card shows the opening. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .more {
    margin-top: 1.5rem;
  }
</style>
