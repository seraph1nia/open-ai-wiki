---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";
import { groupByDay, toItems } from "../lib/changelog";
import { withBase } from "../lib/wiki";

const base = import.meta.env.BASE_URL;
const items = toItems(
  (await getCollection("changelog")).map((fragment) => fragment.data),
);
const days = groupByDay(items);

// Ingestion runs on a UTC cron, so the day headings are read in UTC too.
const dayFormat = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "long",
  timeZone: "UTC",
});

const kindLabels = { new: "New", updated: "Updated", removed: "Removed" };
---

<StarlightPage
  frontmatter={{
    title: "What's new",
    description:
      "Every change to the AI Knowledge wiki, newest first: new pages, substantive updates, and what each one means.",
    tableOfContents: false,
  }}
>
  <p>
    Scheduled ingestion reconciles this wiki against its configured sources
    every day. Each run that changes a page is recorded here, newest first.
    <a href={withBase("/whats-new.xml", base)}>Subscribe via RSS</a>.
  </p>

  {
    days.length === 0 && (
      <p>
        No runs recorded yet. The next scheduled update will start this log.
      </p>
    )
  }

  {
    days.map((day) => {
      const notable = day.items.filter((item) => !item.minor);
      const minor = day.items.filter((item) => item.minor);
      return (
        <section class="day">
          <h2>
            <time datetime={day.day}>{dayFormat.format(day.date)}</time>
          </h2>

          {notable.map((item) => (
            <div class="entry">
              <p class="entry-head">
                <span class={`badge badge-${item.kind}`}>
                  {kindLabels[item.kind]}
                </span>
                {item.href ? (
                  <a class="entry-title" href={withBase(item.href, base)}>
                    {item.title}
                  </a>
                ) : (
                  <span class="entry-title removed">{item.title}</span>
                )}
              </p>
              {item.summary && <p class="entry-summary">{item.summary}</p>}
              <p class="entry-meta">
                {item.type && <span>{item.type}</span>}
                <span>
                  +{item.added} / &minus;{item.removed} lines
                </span>
                {item.resource && (
                  <a
                    href={item.resource}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Source &nearr;
                  </a>
                )}
              </p>
            </div>
          ))}

          {minor.length > 0 && (
            <details class="minor">
              <summary>
                {minor.length} smaller edit{minor.length === 1 ? "" : "s"}
              </summary>
              <ul>
                {minor.map((item) => (
                  <li>
                    {item.href ? (
                      <a href={withBase(item.href, base)}>{item.title}</a>
                    ) : (
                      item.title
                    )}
                    <span class="entry-meta">
                      {" "}
                      +{item.added} / &minus;{item.removed}
                    </span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </section>
      );
    })
  }
</StarlightPage>

<style>
  .day {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 1.5rem;
    margin-top: 2.5rem;
  }
  .day h2 {
    margin: 0 0 1.4rem;
    font-size: var(--sl-text-base);
    color: var(--sl-color-gray-3);
  }
  .entry {
    margin-bottom: 2rem;
  }
  .entry-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 0.3rem;
  }
  .badge {
    flex: none;
    border-radius: 999px;
    border: 1px solid currentcolor;
    padding: 0.1rem 0.6rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .badge-new {
    color: var(--sl-color-green-high);
  }
  .badge-updated {
    color: var(--sl-color-orange-high);
  }
  .badge-removed {
    color: var(--sl-color-gray-3);
  }
  .entry-title {
    font-size: var(--sl-text-lg);
    font-weight: 600;
  }
  .entry-title.removed {
    color: var(--sl-color-gray-3);
    text-decoration: line-through;
  }
  .entry-summary {
    margin: 0.2rem 0 0.4rem;
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .minor summary {
    cursor: pointer;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
