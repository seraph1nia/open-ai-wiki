---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { groupByDay, toItems } from "../lib/changelog";
import { withBase } from "../lib/wiki";

const base = import.meta.env.BASE_URL;
const items = toItems(
  (await getCollection("changelog")).map((fragment) => fragment.data),
);
const days = groupByDay(items);

// Ingestion runs on a UTC cron, so the day headings are read in UTC too.
const dayFormat = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "long",
  timeZone: "UTC",
});

const kindLabels = { new: "New", updated: "Updated", removed: "Removed" };
---

<BaseLayout
  title="What's new"
  description="Every change to the AI Knowledge wiki, newest first: new pages, substantive updates, and what each one means."
>
  <article>
    <p class="eyebrow">Changelog</p>
    <h1>What&rsquo;s new</h1>
    <p class="lede">
      Scheduled ingestion reconciles this wiki against its configured sources
      every day. Each run that changes a page is recorded here, newest first.
    </p>
    <p class="meta feed-link">
      <a href={withBase("/whats-new.xml", base)}>Subscribe via RSS</a>
    </p>

    {
      days.length === 0 && (
        <p class="meta">
          No runs recorded yet. The next scheduled update will start this log.
        </p>
      )
    }

    {
      days.map((day) => {
        const notable = day.items.filter((item) => !item.minor);
        const minor = day.items.filter((item) => item.minor);
        return (
          <section class="day">
            <h2>
              <time datetime={day.day}>{dayFormat.format(day.date)}</time>
            </h2>

            {notable.map((item) => (
              <div class="entry">
                <p class="entry-head">
                  <span class={`badge badge-${item.kind}`}>
                    {kindLabels[item.kind]}
                  </span>
                  {item.href ? (
                    <a class="entry-title" href={withBase(item.href, base)}>
                      {item.title}
                    </a>
                  ) : (
                    <span class="entry-title removed">{item.title}</span>
                  )}
                </p>
                {item.summary && <p class="entry-summary">{item.summary}</p>}
                <p class="meta entry-meta">
                  {item.type && <span>{item.type}</span>}
                  <span>
                    +{item.added} / &minus;{item.removed} lines
                  </span>
                  {item.resource && (
                    <a
                      href={item.resource}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Source &nearr;
                    </a>
                  )}
                </p>
              </div>
            ))}

            {minor.length > 0 && (
              <details class="minor">
                <summary>
                  {minor.length} smaller edit{minor.length === 1 ? "" : "s"}
                </summary>
                <ul>
                  {minor.map((item) => (
                    <li>
                      {item.href ? (
                        <a href={withBase(item.href, base)}>{item.title}</a>
                      ) : (
                        item.title
                      )}
                      <span class="meta">
                        {" "}
                        +{item.added} / &minus;{item.removed}
                      </span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </section>
        );
      })
    }
  </article>
</BaseLayout>

<style>
  article {
    max-width: 800px;
  }
  .feed-link {
    margin-bottom: 3rem;
  }
  .day {
    border-top: 1px solid var(--line);
    padding-top: 1.6rem;
    margin-top: 2.6rem;
  }
  .day h2 {
    margin: 0 0 1.4rem;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    font-weight: 600;
  }
  .entry {
    margin-bottom: 2rem;
  }
  .entry-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 0.3rem;
  }
  .badge {
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--line);
    padding: 0.1rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .badge-new {
    color: var(--accent);
    border-color: #477a68;
  }
  .badge-updated {
    color: var(--accent2);
    border-color: #6b5a33;
  }
  .badge-removed {
    color: var(--muted);
  }
  .entry-title {
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
  }
  .entry-title.removed {
    color: var(--muted);
    text-decoration: line-through;
  }
  .entry-summary {
    margin: 0.2rem 0 0.4rem;
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .minor summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .minor ul {
    padding-left: 1.2rem;
  }
</style>
