---
import { getCollection } from "astro:content";
import { entryPath, isDirectoryIndex, titleFor, withBase } from "../lib/wiki";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "A self-updating knowledge base for AI protocols and agent systems.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = (await getCollection("wiki"))
  .filter(isDirectoryIndex)
  .filter((entry) => !entry.id.includes("/"))
  .map((entry) => ({
    href: withBase(entryPath(entry.id), base),
    label: titleFor(entry),
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta name="description" content={description} /><link
      rel="alternate"
      type="application/rss+xml"
      title="AI Knowledge — What's new"
      href={`${base}whats-new.xml`}
    /><title>
      {title} · AI Knowledge
    </title></head
  >
  <body>
    <header>
      <a class="brand" href={base}>AI Knowledge</a><nav>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav><a class="search-link" href={`${base}whats-new/`}
        >What&rsquo;s new</a
      ><a class="search-link" href={`${base}search/`}>Search</a>
    </header>
    <main><slot /></main>
    <footer>Durable technical knowledge, synthesized with provenance.</footer>
    <script>
      const blocks = document.querySelectorAll<HTMLElement>("pre.mermaid");
      if (blocks.length > 0) {
        blocks.forEach((block) => block.classList.add("mermaid-pending"));
        try {
          const { default: mermaid } = await import("mermaid");
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: "strict",
            theme: "base",
            fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif",
            themeVariables: {
              darkMode: true,
              background: "#0d1917",
              primaryColor: "#10201d",
              primaryTextColor: "#edf6f1",
              primaryBorderColor: "#477a68",
              secondaryColor: "#123329",
              tertiaryColor: "#07100f",
              lineColor: "#72e1b4",
              textColor: "#edf6f1",
              mainBkg: "#10201d",
              nodeBorder: "#477a68",
            },
          });
          await mermaid.run({ nodes: blocks });
        } catch (error) {
          console.error("Failed to render mermaid diagrams", error);
        } finally {
          blocks.forEach((block) => {
            block.classList.remove("mermaid-pending");
            // `mermaid.run` aborts the whole batch on the first bad diagram, so
            // flag every block that never received an SVG rather than assuming
            // a thrown error means none of them rendered.
            if (!block.querySelector("svg")) {
              block.classList.add("mermaid-failed");
            }
          });
        }
      }
    </script>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: dark;
    --bg: #07100f;
    --panel: #0d1917;
    --ink: #edf6f1;
    --muted: #9ab0a8;
    --line: #20332e;
    --accent: #72e1b4;
    --accent2: #e6b96a;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background:
      radial-gradient(circle at 80% 0, #123329 0, transparent 36rem), var(--bg);
    color: var(--ink);
    line-height: 1.65;
  }
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1rem max(1.25rem, calc((100vw - 1160px) / 2));
    border-bottom: 1px solid var(--line);
    background: #07100ee8;
    backdrop-filter: blur(16px);
  }
  .brand {
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 1rem;
    flex: 1;
    overflow: auto;
  }
  nav a,
  .search-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .search-link {
    white-space: nowrap;
  }
  nav a:hover,
  .search-link:hover,
  a {
    color: var(--accent);
  }
  main {
    width: min(1160px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3.5rem 0 6rem;
  }
  footer {
    border-top: 1px solid var(--line);
    padding: 2rem;
    text-align: center;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    margin: 0.2em 0;
  }
  h2 {
    margin-top: 2.3rem;
    line-height: 1.15;
  }
  p {
    max-width: 76ch;
  }
  .eyebrow {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .lede {
    color: var(--muted);
    font-size: 1.2rem;
    max-width: 65ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }
  .card {
    display: block;
    padding: 1.3rem;
    border: 1px solid var(--line);
    background: linear-gradient(145deg, #10201d, #0a1513);
    border-radius: 14px;
    text-decoration: none;
    color: var(--ink);
  }
  .card:hover {
    border-color: #477a68;
    transform: translateY(-2px);
  }
  .card small,
  .meta {
    color: var(--muted);
  }
  .count {
    font-size: 2rem;
    color: var(--accent2);
    font-weight: 800;
  }
  .prose {
    max-width: 800px;
  }
  .prose img {
    max-width: 100%;
  }
  .prose pre {
    overflow: auto;
    padding: 1rem;
    background: #030807;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .prose pre.mermaid {
    display: flex;
    justify-content: center;
    background: var(--panel);
  }
  .prose pre.mermaid svg {
    max-width: 100%;
    height: auto;
  }
  pre.mermaid-pending {
    visibility: hidden;
  }
  .prose pre.mermaid-failed {
    display: block;
    background: #030807;
    border-color: var(--accent2);
  }
  .prose pre.mermaid-failed::before {
    content: "Diagram failed to render — see the browser console.";
    display: block;
    margin-bottom: 0.75rem;
    color: var(--accent2);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.8rem;
  }
  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    color: var(--muted);
  }
  .concept-meta {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .chip {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 3rem;
  }
  .side {
    position: sticky;
    top: 6rem;
    align-self: start;
    border-left: 1px solid var(--line);
    padding-left: 1.2rem;
  }
  .side ul {
    padding-left: 1rem;
  }
  input[type="search"] {
    width: 100%;
    font: inherit;
    font-size: 1.2rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    color: var(--ink);
  }
  @media (max-width: 760px) {
    header {
      gap: 1rem;
    }
    .page-grid {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 1rem 0;
    }
    nav {
      display: none;
    }
  }
</style>
